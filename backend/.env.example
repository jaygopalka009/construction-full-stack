# ========================================================
# Construction ERP - Backend Environment Configuration
# ========================================================

# Server Port
PORT=5000

# MongoDB Connection String
# For local instance: mongodb://127.0.0.1:27017/construction_erp
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/construction_erp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/construction_erp

# JWT Secret Key for token signing & verification
JWT_SECRET=your_jwt_secret_here

# Node Environment (development / production)
NODE_ENV=development
