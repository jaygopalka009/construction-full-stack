  .badge-blue { background: #dbeafe; color: #1e40af; }
  .badge-green { background: #dcfce7; color: #166534; }
  .badge-amber { background: #fef3c7; color: #92400e; }
  .callout { background: #f8fafc; border-left: 5px solid #2563eb; padding: 12px 18px; margin: 15px 0; border-radius: 0 8px 8px 0; }
  .speech-box { background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 8px; padding: 15px; margin: 15px 0; }
